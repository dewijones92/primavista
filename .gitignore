*.iml
.gradle/
.idea/
.DS_Store
.kotlin/

# Build outputs in any module, not just the root. A bare /build misses app/build,
# core/*/build and lib/*/build, which is 700-odd files of compiler cache.
build/
/captures
.externalNativeBuild
.cxx

# Local machine config (SDK path)
local.properties

# Never commit signing material. The release key lives outside this repo, in Actions
# secrets, and in a private backup repo — these patterns are the safety net against a
# stray local copy.
*.jks
*.keystore
keystore.properties
signing.properties

# Secrets and local env
.env
.env.*

# Logs and local agent scratch (worktrees, session files)
*.log
/dev/active

# .claude/ holds local agent scratch, EXCEPT CODE-NOTES.md — the comment rule in CLAUDE.md sends
# every explanation over ~30 characters there, so ignoring it would delete the substance rather
# than relocate it. Git cannot re-include a file whose parent directory is excluded, hence
# `.claude/*` rather than `.claude/`.
.claude/*
!.claude/CODE-NOTES.md
