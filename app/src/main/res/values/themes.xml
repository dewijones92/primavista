<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose owns the real theme; this exists so the window has the brand's ink
         background before the first frame instead of flashing platform white. -->
    <style name="Theme.PrimaVista" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/brand_ink</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
